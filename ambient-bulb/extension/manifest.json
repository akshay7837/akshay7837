{
  "manifest_version": 3,
  "name": "Ambient Bulb for YouTube",
  "version": "1.0.0",
  "description": "Syncs your Wi-Fi smart bulb (Havells Digitap / Tuya) to the colours of the YouTube video you're watching.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Ambient Bulb" }
}
